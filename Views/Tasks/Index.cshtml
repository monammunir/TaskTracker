@model IEnumerable<TaskTrackr.Models.TaskItem>

@{
    ViewData["Title"] = "Dashboard";

    var totalTasks = Model.Count();
    var completedTasks = Model.Count(t => t.Status == "Completed");
    var pendingTasks = Model.Count(t => t.Status == "Pending");
    var inProgressTasks = Model.Count(t => t.Status == "In Progress");
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

    <div>
        <h1 class="dashboard-title mb-1">
            My Tasks
        </h1>

        <p class="dashboard-subtitle mb-0">
            Stay organized and keep your work on track.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary mt-3 mt-md-0 px-4">
        + New Task
    </a>

</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4">
        ✓ @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<!-- Statistics -->

<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small">
                Total Tasks
            </div>

            <div class="fs-3 fw-bold">
                @totalTasks
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small">
                Pending
            </div>

            <div class="fs-3 fw-bold text-secondary">
                @pendingTasks
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small">
                In Progress
            </div>

            <div class="fs-3 fw-bold text-primary">
                @inProgressTasks
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small">
                Completed
            </div>

            <div class="fs-3 fw-bold text-success">
                @completedTasks
            </div>
        </div>
    </div>

</div>

<!-- Search / Filters -->

<div class="card p-4 mb-4">

    <form asp-action="Index" method="get">

        <div class="row g-3">

            <div class="col-lg-4">

                <label class="form-label fw-semibold">
                    Search
                </label>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search by title or description..." />

            </div>

            <div class="col-lg-3">

                <label class="form-label fw-semibold">
                    Status
                </label>

                <select name="status"
                        class="form-select">

                    <option value="">
                        All Statuses
                    </option>

                    @foreach (var status in ViewBag.Statuses)
                    {
                        if (ViewBag.Status == status)
                        {
                            <option value="@status" selected>
                                @status
                            </option>
                        }
                        else
                        {
                            <option value="@status">
                                @status
                            </option>
                        }
                    }

                </select>

            </div>

            <div class="col-lg-3">

                <label class="form-label fw-semibold">
                    Priority
                </label>

                <select name="priority"
                        class="form-select">

                    <option value="">
                        All Priorities
                    </option>

                    @foreach (var priority in ViewBag.Priorities)
                    {
                        if (ViewBag.Priority == priority)
                        {
                            <option value="@priority" selected>
                                @priority
                            </option>
                        }
                        else
                        {
                            <option value="@priority">
                                @priority
                            </option>
                        }
                    }

                </select>

            </div>

            <div class="col-lg-2 d-flex align-items-end">

                <button type="submit"
                        class="btn btn-dark w-100">
                    Filter
                </button>

            </div>

        </div>

    </form>

</div>

<!-- Sorting -->

<div class="d-flex flex-wrap gap-2 mb-4">

    <a asp-action="Index"
       asp-route-search="@ViewBag.Search"
       asp-route-status="@ViewBag.Status"
       asp-route-priority="@ViewBag.Priority"
       asp-route-sort="dueDate"
       class="btn btn-sm btn-outline-secondary">
        Due Date ↑
    </a>

    <a asp-action="Index"
       asp-route-search="@ViewBag.Search"
       asp-route-status="@ViewBag.Status"
       asp-route-priority="@ViewBag.Priority"
       asp-route-sort="dueDate_desc"
       class="btn btn-sm btn-outline-secondary">
        Due Date ↓
    </a>

    <a asp-action="Index"
       class="btn btn-sm btn-outline-secondary">
        Clear Filters
    </a>

</div>

@if (!Model.Any())
{
    <div class="card empty-state">

        <div class="empty-state-icon">
            📋
        </div>

        <h4 class="fw-bold">
            No tasks found
        </h4>

        <p class="text-muted">
            You don't have any tasks yet.
        </p>

        <div>
            <a asp-action="Create"
               class="btn btn-primary">
                Create Your First Task
            </a>
        </div>

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var task in Model)
        {
            var priorityClass = task.Priority switch
            {
                "High" => "danger",
                "Medium" => "warning text-dark",
                _ => "success"
            };

            var statusClass = task.Status switch
            {
                "Completed" => "success",
                "In Progress" => "primary",
                _ => "secondary"
            };

            <div class="col-md-6 col-xl-4">

                <div class="card task-card h-100">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-start mb-3">

                            <span class="badge bg-@priorityClass">
                                @task.Priority
                            </span>

                            <span class="badge bg-@statusClass">
                                @task.Status
                            </span>

                        </div>

                        <h5 class="fw-bold mb-2">
                            @task.Title
                        </h5>

                        <p class="text-muted mb-3">

                            @if (string.IsNullOrWhiteSpace(task.Description))
                            {
                                <span>No description provided.</span>
                            }
                            else
                            {
                                @task.Description
                            }

                        </p>

                        <div class="small text-muted">

                            <strong>Due date:</strong>

                            @(task.DueDate?.ToString("dd MMM yyyy")
                                ?? "No due date")

                        </div>

                    </div>

                    <div class="card-footer bg-white border-0 p-3">

                        <div class="d-flex gap-2">

                            <a asp-action="Details"
                               asp-route-id="@task.Id"
                               class="btn btn-sm btn-outline-primary flex-fill">
                                Details
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@task.Id"
                               class="btn btn-sm btn-outline-warning flex-fill">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@task.Id"
                               class="btn btn-sm btn-outline-danger flex-fill">
                                Delete
                            </a>

                        </div>

                        @if (task.Status != "Completed")
                        {
                            <form asp-action="Complete"
                                  asp-route-id="@task.Id"
                                  method="post"
                                  class="mt-2">

                                <button type="submit"
                                        class="btn btn-sm btn-success w-100">
                                    ✓ Mark Complete
                                </button>

                            </form>
                        }

                    </div>

                </div>

            </div>
        }

    </div>
}